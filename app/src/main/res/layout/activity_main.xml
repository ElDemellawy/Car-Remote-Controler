<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_car">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="86dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="76dp"
        android:text="Car Remote Control"
        android:textColor="#040000"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/btnLock"

        android:layout_alignParentEnd="true"
        android:layout_marginTop="-102dp"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="Unlock"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_unlock" />

    <ImageButton
        android:id="@+id/btnLock"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/titleText"
        android:layout_marginTop="290dp"
        android:background="@android:color/transparent"
        android:contentDescription="Lock"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="136dp"
        android:layout_height="32dp"
        android:layout_below="@id/btnUnlock"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="134dp"
        android:layout_marginTop="230dp"
        android:layout_marginEnd="141dp"
        android:layout_marginBottom="32dp"
        android:text="Status: Locked"
        android:textColor="#3E0303"
        android:textSize="20sp" />
</RelativeLayout>

